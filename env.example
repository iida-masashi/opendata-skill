# opendata-skill 環境変数テンプレート
# このファイルを .env という名前でコピーし、利用するデータソースのキーだけ設定してください。
#   cp env.example .env
# 未設定のキーに対応するフェッチャーは、実行時に取得先の案内を表示して終了します。
# .env は .gitignore 済みです。絶対にコミットしないでください。

# --- 日本の政府・公的機関 ---
# e-Stat API (必須表記あり: docs/DATA_SOURCE_TERMS.md 参照) https://www.e-stat.go.jp/api/
ESTAT_API_KEY=
# 国税庁 法人番号システム Web-API (アプリケーションID) https://www.houjin-bangou.nta.go.jp/
CORP_API_KEY=
# 国土交通省 不動産情報ライブラリ https://www.reinfolib.mlit.go.jp/
MLIT_API_KEY=
# 公共交通オープンデータセンター (開発者登録が必要) https://developer.odpt.org/
ODPT_API_KEY=
# RESAS (地域経済分析システム) https://opendata.resas-portal.go.jp/
RESAS_API_KEY=
# EDINET (edinetdb ライブラリ経由) https://pypi.org/project/edinetdb/
EDINETDB_API_KEY=

# --- 海外の公的機関・国際機関 ---
# FRED (セントルイス連銀) https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# 米国エネルギー情報局 (EIA) https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# UN Comtrade https://comtradeplus.un.org/
COMTRADE_API_KEY=
# USDA NASS QuickStats https://quickstats.nass.usda.gov/api
USDA_API_KEY=
# NASA FIRMS (MAP KEY) https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=
# ENTSO-E Transparency Platform (要登録) https://transparency.entsoe.eu/
ENTSOE_API_KEY=

# --- 民間サービス (有償・要契約) ---
# YouTube Data API v3 https://console.cloud.google.com/
YOUTUBE_API_KEY=
# xAI Grok API (有償) https://console.x.ai/
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1/chat/completions
# XAI_MODEL=grok-4-latest
# Datalastic AIS (商用有償) https://datalastic.com/
DATALASTIC_API_KEY=
# AISHub (データ提供メンバーのみ) https://www.aishub.net/
AISHUB_USERNAME=
